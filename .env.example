# ============================================================
#  BSL/SSL Liquidity Scanner — configuration
#  Copy this file to `.env` and fill in your values.
#  `.env` is git-ignored — your tokens never enter the repo.
# ============================================================

# ---- Telegram (BOTH bots receive the SAME alerts) --------------
# Get tokens from @BotFather on Telegram.
BOT1_TOKEN=
BOT2_TOKEN=
# Chat/group/channel ID for bot 1 (and bot 2 unless CHAT_ID_2 is set).
# Numeric IDs (e.g. -1001234567890) or @channelusername.
CHAT_ID=
CHAT_ID_2=
TELEGRAM_ENABLED=true

# ---- Symbol: NSE:NIFTY only (^NSEI on Yahoo Finance) ------------
SYMBOL=^NSEI
DISPLAY_SYMBOL=NSE:NIFTY

# ---- Timeframes ------------------------------------------------
TIMEFRAMES=1m,5m

# ---- Scanning --------------------------------------------------
SCAN_INTERVAL_SEC=20
MARKET_HOURS_ONLY=true
SESSION_START=09:15
SESSION_END=15:30
TZ=Asia/Kolkata

# ---- Alerts ----------------------------------------------------
# send separate 🧹 sweep alerts in addition to BUY/SELL start signals
SWEEP_ALERTS=true

# ---- Indicator settings (defaults = identical to the Pine script) --
PIV_LEN=8
ATR_LEN=14
ZONE_ATR_MULT=0.25
EQ_TOL_ATR=0.15
MAX_POOLS=12
POOL_EXPIRY=300
# Signal direction: "BSL→SELL · SSL→BUY" (default fade) or "BSL→BUY · SSL→SELL" (magnet)
SIG_DIR=BSL→SELL · SSL→BUY
ATR_SL=1.2
RR_TARGET=2.0

# ---- State / logs ----------------------------------------------
STATE_FILE=data/sent_alerts.json
LOG_FILE=logs/scanner.log
LOG_LEVEL=INFO
