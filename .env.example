# ============================================================
#  BSL/SSL Liquidity Scanner — configuration
#  Copy this file to `.env` and fill in your values.
#  `.env` is git-ignored — your tokens never enter the repo.
# ============================================================

# ---- Telegram (BOTH bots receive the SAME alerts) --------------
# Get tokens from @BotFather on Telegram.
BOT1_TOKEN=
BOT2_TOKEN=
# Chat/group/channel ID for bot 1 (and bot 2 unless CHAT_ID_2 is set).
# Numeric IDs (e.g. -1001234567890) or @channelusername.
CHAT_ID=
CHAT_ID_2=
TELEGRAM_ENABLED=true

# ---- TradingView Webhook (Zero Delay Direct Alerts) ------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
# ⚠️  SET THIS before exposing the port. Without it, ANYONE who finds the
# endpoint can push fake BUY/SELL messages to both your Telegram bots.
# Use any long random string, then point TradingView at:
#   http://<your-host>:5000/webhook?secret=<this value>
WEBHOOK_SECRET=

# ---- Symbol: NSE:NIFTY only (^NSEI on Yahoo Finance) ------------
SYMBOL=^NSEI
DISPLAY_SYMBOL=NSE:NIFTY

# ---- Timeframes ------------------------------------------------
TIMEFRAMES=1m,5m

# ---- Scanning --------------------------------------------------
SCAN_INTERVAL_SEC=20
MARKET_HOURS_ONLY=true
SESSION_START=09:15
SESSION_END=15:30
TZ=Asia/Kolkata

# ---- Cloud / GitHub Actions lookback mode ----------------------
# 0 = off (normal live mode). Set to e.g. 20 to scan the last 20 minutes of
# closed bars on every run (used by .github/workflows/scanner.yml).
# Dedupe still comes from data/sent_alerts.json — no alert repeats.
LOOKBACK_MINUTES=0

# ---- Alerts ----------------------------------------------------
# send separate 🧹 sweep alerts in addition to BUY/SELL start signals
SWEEP_ALERTS=true

# ---- Indicator settings (defaults = identical to the Pine script) --
PIV_LEN=8
# TIER 2 fast swing (3 bars = 15m on 5m, 3m on 1m) — 62% faster than PIV_LEN=8
FAST_PIV_LEN=3
FAST_SIGNALS=true
# TIER 1 instant sweep trades: 0-bar lag, wick SL, 1:2 R:R
INSTANT_SWEEP_TRADES=true
ATR_LEN=14
ZONE_ATR_MULT=0.25
EQ_TOL_ATR=0.15
MAX_POOLS=12
POOL_EXPIRY=300
# Signal direction: "BSL→SELL · SSL→BUY" (default fade) or "BSL→BUY · SSL→SELL" (magnet)
SIG_DIR=BSL→SELL · SSL→BUY
ATR_SL=1.2
RR_TARGET=2.0

# ---- State / logs ----------------------------------------------
STATE_FILE=data/sent_alerts.json
LOG_FILE=logs/scanner.log
LOG_LEVEL=INFO
